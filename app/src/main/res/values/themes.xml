<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de Café Raquelita -->
    <style name="Theme.CafeRaquelita" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/cafe_green</item>
        <item name="colorPrimaryDark">@color/cafe_green_dark</item>
        <item name="colorAccent">@color/cafe_yellow</item>
        
        <!-- Colores de fondo -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/cafe_green_dark</item>
        
        <!-- Colores de texto -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Estilo de botones -->
        <item name="android:buttonStyle">@style/Widget.CafeRaquelita.Button</item>
        
        <!-- Estilo de Toolbar -->
        <item name="toolbarStyle">@style/Widget.CafeRaquelita.Toolbar</item>
    </style>
    
    <!-- Estilo para botones -->
    <style name="Widget.CafeRaquelita.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_cafe_raquelita</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Estilo para Toolbar -->
    <style name="Widget.CafeRaquelita.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/cafe_green</item>
        <item name="android:titleTextColor">@color/text_light</item>
    </style>
    
    <!-- Estilo para diálogos -->
    <style name="Dialog.CafeRaquelita" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">@color/cafe_green</item>
        <item name="colorAccent">@color/cafe_yellow</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>