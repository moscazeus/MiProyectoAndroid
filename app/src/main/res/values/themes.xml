<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal basado en MaterialComponents -->
    <style name="Theme.CafeRaquelita" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores -->
        <item name="colorPrimary">@color/cafe_green</item>
        <item name="colorPrimaryVariant">@color/cafe_green_dark</item>
        <item name="colorSecondary">@color/cafe_yellow</item>

        <!-- Fondo / status bar -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/cafe_green_dark</item>

        <!-- Textos -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Componentes -->
        <item name="toolbarStyle">@style/Widget.CafeRaquelita.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CafeRaquelita.MaterialAlertDialog</item>
        <item name="buttonStyle">@style/Widget.CafeRaquelita.Button</item>
    </style>

    <!-- Botón estilo Material -->
    <style name="Widget.CafeRaquelita.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/cafe_green</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.CafeRaquelita.Button</item>
    </style>

    <!-- Esquinas redondeadas para botones -->
    <style name="ShapeAppearanceOverlay.CafeRaquelita.Button">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.CafeRaquelita.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/cafe_green</item>
        <item name="titleTextColor">@color/text_light</item>
        <item name="subtitleTextColor">@color/text_light</item>
    </style>

    <!-- Overlay para MaterialAlertDialog -->
    <style name="ThemeOverlay.CafeRaquelita.MaterialAlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/cafe_green</item>
        <item name="colorSecondary">@color/cafe_yellow</item>
    </style>

    <!-- **Overlay genérico que pedía AAPT** -->
    <style name="ShapeAppearanceOverlay.CafeRaquelita" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
